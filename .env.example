# Copy this file to .env and fill in the values.
# Never commit your real .env file.

# ─── Required ────────────────────────────────────────────────

# PostgreSQL connection string (Neon, Supabase, local Postgres, ...)
DATABASE_URL="postgresql://user:password@localhost:5432/genetix"

# OpenAI: powers the code-generation agent
OPENAI_API_KEY="sk-..."

# Public URL of this app, so Inngest can reach /api/ai/responses-bridge (reasoning tokens:
# low for Simple & Fast and App builds, medium for Advanced Reasoning).
# Falls back to NEXT_PUBLIC_APP_URL, then NEXTAUTH_URL. If none is set, builds run without reasoning.
APP_URL=""

# You.com (optional): gives the code agent a live `webSearch` tool.
# Leave empty to disable web search. https://you.com/platform
YOU_API_KEY=""

# E2B: cloud sandboxes that run and preview the generated apps
# https://e2b.dev/dashboard
E2B_API_KEY="e2b_..."
# Your own sandbox template ID. Build it from sandbox-templates/nextjs (see README).
E2B_TEMPLATE_ID=""

# NextAuth: generate a secret with `openssl rand -base64 32`
NEXTAUTH_SECRET="replace-with-a-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# Public URLs of this app
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ─── Background jobs (Inngest) ───────────────────────────────
# Not needed locally when running `npx inngest-cli@latest dev`.
# Required in production: https://app.inngest.com
INNGEST_SIGNING_KEY=""
INNGEST_EVENT_KEY=""

# ─── OAuth sign-in (optional) ────────────────────────────────
# Google: https://console.cloud.google.com/apis/credentials
# Redirect URI: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# GitHub: https://github.com/settings/developers
# Callback URL: http://localhost:3000/api/auth/callback/github
GITHUB_ID=""
GITHUB_SECRET=""

# ─── Admin (optional) ────────────────────────────────────────
# Account that can open the admin panel and approve credit requests
ADMIN_EMAIL=""
ADMIN_PASSWORD=""

# ─── Email (SMTP) ────────────────────────────────────────────
# Used for credit-request notifications AND email verification on email/password signup.
# REQUIRED in production for email/password signup: without SMTP, signup returns an error
# (accounts are never created unverified-but-usable). In development, verification links are
# printed to the server console instead. Verification links use APP_URL / NEXT_PUBLIC_APP_URL /
# NEXTAUTH_URL (first one set) as the base URL.
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
# Optional "From" header for outgoing mail, e.g. "Genetix <no-reply@example.com>".
# Defaults to "Genetix" <SMTP_USER>.
SMTP_FROM=""

# ─── Stock images for generated sites (optional) ─────────────
UNSPLASH_ACCESS_KEY=""
PEXELS_API_KEY=""

# ─── Prompt generator model (optional) ───────────────────────
PROMPT_MODEL="gpt-6-luna"

# ─── Payments (optional) ─────────────────────────────────────
RAZORPAY_KEY_SECRET=""
CASHFREE_APP_ID=""
CASHFREE_SECRET_KEY=""
CASHFREE_ENV="sandbox"

# ─── AIQuest integration (optional) ──────────────────────────
# Shared with the AIQuest backend for the World 6 handoff (32+ random characters)
AIQUEST_HANDOFF_SECRET=""

# ─── Publishing (one-click publish) ──────────────────────────
# Published static sites are served at <base>/s/<slug>/. They run untrusted, AI-generated JS.
#
# PUBLISH_BASE_URL (optional, recommended in production): a SEPARATE origin for published sites,
# e.g. https://genetix-sites.vercel.app, added as a second domain alias of this same deployment.
# When set, /s/* requests arriving on any other host are redirected there, so published sites
# never share an origin (cookies/storage/API session) with the Genetix app.
#
# When NOT set, sites are served from the app's own origin inside a CSP sandbox
# ("Content-Security-Policy: sandbox ..."), which gives each page an opaque origin so it cannot
# read the app's cookies or call its APIs with a visitor's session. Side effect: localStorage,
# sessionStorage, IndexedDB and cookies do NOT work on published sites in sandboxed mode
# (scripts that use them may throw). Set PUBLISH_BASE_URL to get fully working sites.
# Published links fall back to APP_URL / NEXT_PUBLIC_APP_URL / NEXTAUTH_URL when unset.
PUBLISH_BASE_URL=""

# ─── Build pipeline (optional) ───────────────────────────────
# Max tokens (input + output) per AI build before the agents are told to wrap up.
BUILD_TOKEN_BUDGET="300000"
# Real-browser QA runs inside the E2B sandbox. Rebuild the template from
# sandbox-templates/nextjs (it preinstalls Playwright + Chromium). Until then you can set
# this to "true" to install the browser at runtime (adds ~1 min per build).
BROWSER_QA_RUNTIME_INSTALL="false"
# Vision model that reviews screenshots of each build, and the model that names projects.
DESIGN_REVIEW_MODEL="gpt-6-luna"
NAMING_MODEL="gpt-6-luna"
